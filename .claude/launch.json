{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "reservation-app",
      "runtimeExecutable": "./gradlew",
      "runtimeArgs": [
        "bootRun"
      ],
      "port": 8080
    },
    {
      "name": "infra",
      "runtimeExecutable": "docker",
      "runtimeArgs": [
        "compose",
        "up"
      ],
      "port": 3306
    },
    {
      "name": "reservation-app-optimistic-20",
      "runtimeExecutable": "./gradlew",
      "runtimeArgs": [
        "bootRun",
        "--args=--reservation.optimistic.max-attempts=20"
      ],
      "port": 8080
    }
  ]
}
